generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        String         @id @default(cuid())
  name      String         @unique
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model VehicleModel {
  id          String       @id @default(cuid())
  brandId     String
  name        String
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  generations Generation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([brandId, name])
}

model Generation {
  id        String         @id @default(cuid())
  modelId   String
  name      String
  startYear Int?
  endYear   Int?
  bodyType  String?
  model     VehicleModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  engines   EngineOption[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model EngineOption {
  id             String               @id @default(cuid())
  generationId   String
  label          String
  fuelType       String?
  engineVolume   String?
  powerHp        Int?
  torqueNm       Int?
  sourceName     String?
  sourceUrl      String?
  specs          Json?
  generation     Generation           @relation(fields: [generationId], references: [id], onDelete: Cascade)
  transmissions  TransmissionOption[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model TransmissionOption {
  id        String       @id @default(cuid())
  engineId  String
  label     String
  engine    EngineOption @relation(fields: [engineId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([engineId, label])
}

model AnalysisReport {
  id              String   @id @default(cuid())
  analysisType    String
  vehiclePayload  Json
  userInputs      Json?
  aiReport        Json
  confidenceScore Int?
  createdAt       DateTime @default(now())
}

model MarketListing {
  id              String   @id @default(cuid())

  brand           String
  model           String
  bodyType        String?
  year            Int?
  engine          String?
  fuelType        String?
  transmission    String?
  packageName     String?

  km              Int?
  price           Int
  currency        String   @default("TRY")

  sourceName      String?
  sourceUrl       String?
  sourceType      String?  // ai_search, indexed_web, admin_import, user_target, partner_api

  title           String?
  vehicleText     String?
  location        String?

  cleanSignal     Boolean  @default(false)
  damageSignal    Boolean  @default(false)
  tramerSignal    Boolean  @default(false)

  matchScore      Int?
  matchQuality    String?
  confidence      String?

  capturedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([brand, model, year])
  @@index([brand, model, engine])
  @@index([brand, model, transmission])
  @@index([km])
  @@index([price])
  @@index([capturedAt])
}